# Copy this file to .env and fill in your own values. Never commit .env.

# REQUIRED: encrypts the sign-in cookie. Use a long random value (at least 32 characters).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=<PASTE_A_LONG_RANDOM_SECRET_HERE>

# OPTIONAL: your public site address, used for social previews, robots.txt and the sitemap.
SITE_URL=http://localhost:3000

# OPTIONAL: your own Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty for no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
