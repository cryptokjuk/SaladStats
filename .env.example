# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Random secret for signing sessions - generate with: openssl rand -base64 32
AUTH_SECRET="<random-secret>"
NEXTAUTH_SECRET="<same-random-secret>"

# Optional: Google Analytics 4 measurement ID (leave empty to disable analytics)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Optional: local test account created by `yarn prisma db seed`
SEED_TEST_EMAIL=""
SEED_TEST_PASSWORD=""
