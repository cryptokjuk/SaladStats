{
  "id": "/",
  "name": "Salad Stats",
  "short_name": "SaladStats",
  "description": "Track your Salad.com earnings on the go",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#fafaf5",
  "theme_color": "#fafaf5",
  "orientation": "portrait-primary",
  "categories": ["finance", "utilities", "productivity"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/salad-stats-logo-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "/screenshots/signin-narrow.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Sign in with your Salad account" },
    { "src": "/screenshots/signin-wide.png", "sizes": "1280x720", "type": "image/png", "form_factor": "wide", "label": "Salad Stats sign-in on desktop" }
  ],
  "shortcuts": [
    { "name": "Dashboard", "url": "/dashboard", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Earnings", "url": "/earnings", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
